                    <outputColumn
                      refId="Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].Columns[summaryDate]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].ExternalColumns[summaryDate]"
                      length="10"
                      lineageId="Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].Columns[summaryDate]"
                      name="summaryDate"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].Columns[totalLeads]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversion"
