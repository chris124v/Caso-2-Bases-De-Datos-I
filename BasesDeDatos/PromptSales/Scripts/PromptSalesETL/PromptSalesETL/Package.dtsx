                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">#{Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].Columns[totalLeads]} &gt; 0 ? (DT_NUMERIC,5,2)(((DT_R8)#{Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].Columns[convertedLeads]} / (DT_R8)#{Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].Columns[totalLeads]}) * 100.0) : (DT_NUMERIC,5,2)0.0</property>
                        <property
