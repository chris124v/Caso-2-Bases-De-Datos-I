    <DTS:Executable
      DTS:refId="Package\Extract Raw - PromptAds (PublishedAds)"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{4F18E0D5-AFE4-42F7-9FD7-4964221E2892}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Raw - PromptAds (PublishedAds)"
      DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\Extract Raw - PromptAds (PublishedAds)\Extract de PAPublishedAds"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Extract de PAPublishedAds"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT TOP 400
    pa.IdPublishedAd,
    c.name AS campaignName,  -- CAMBIO: Traemos el nombre en lugar del ID
    ISNULL(COALESCE(ch1.name, ch2.name), 'Unknown') AS channelName,
    CASE 
        WHEN pa.IdInfluencerContact IS NOT NULL THEN 'Influencer'
        ELSE 'Organization'
    END AS channelType,
    ISNULL(i.username, '') AS influencerName,
    ISNULL(i.followers, 0) AS influencerFollowers,
    ISNULL(CAST(pa.body AS VARCHAR(MAX)), '') AS body,
    ISNULL(pa.redirectURL, '') AS redirectURL,
    ISNULL(perf.budget, 0) AS budget,
    ISNULL(perf.expenses, 0) AS expenses,
    ISNULL(sent.name, 'Unknown') AS adSentiment,
    pa.createdAt AS publishedAt,
    ISNULL(stat.name, 'Unknown') AS adStatus,
    pa.createdAt,
    pa.updatedAt,
    -- JSON CON campaignName
    (SELECT 
        pa.IdPublishedAd,
        c.name AS campaignName,  -- CAMBIO AQUÍ TAMBIÉN
        ISNULL(COALESCE(ch1.name, ch2.name), 'Unknown') AS channelName,
        CASE WHEN pa.IdInfluencerContact IS NOT NULL THEN 'Influencer' ELSE 'Organization' END AS channelType,
        ISNULL(i.username, '') AS influencerName,
        ISNULL(i.followers, 0) AS influencerFollowers,
        ISNULL(CAST(pa.body AS VARCHAR(MAX)), '') AS body,
        ISNULL(pa.redirectURL, '') AS redirectURL,
        ISNULL(perf.budget, 0) AS budget,
        ISNULL(perf.expenses, 0) AS expenses,
        ISNULL(sent.name, 'Unknown') AS adSentiment,
        ISNULL(stat.name, 'Unknown') AS adStatus
     FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) AS rawDataJSON
FROM PAPublishedAds pa
INNER JOIN PACampaignAds ca ON ca.IdCampaignAd = pa.IdCampaignAd
INNER JOIN PACampaigns c ON c.IdCampaign = ca.IdCampaign  -- JOIN para traer nombre
INNER JOIN PAAdPerformances perf ON perf.IdPublishedAd = pa.IdPublishedAd 
    AND perf.isCurrent = 1
    AND (perf.budget &gt; 0 OR perf.expenses &gt; 0)
LEFT JOIN PAOrganizationContacts oc ON oc.IdOrganizationContact = pa.IdOrganizationContact
LEFT JOIN PAInfluencerContacts ic ON ic.IdInfluencerContact = pa.IdInfluencerContact
LEFT JOIN PAChannels ch1 ON ch1.IdChannel = oc.IdChannel
LEFT JOIN PAChannels ch2 ON ch2.IdChannel = ic.IdChannel
LEFT JOIN PAInfluencers i ON i.IdInfluencer = ic.IdInfluencer
LEFT JOIN PAAdSentiments sent ON sent.IdAdSentiment = perf.IdAdSentiment
LEFT JOIN PAAdStatus stat ON stat.IdAdStatus = pa.IdAdStatus
ORDER BY pa.IdPublishedAd;</property>
