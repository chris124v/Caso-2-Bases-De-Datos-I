                      name="summaryDate"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].Columns[totalLeads]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].ExternalColumns[totalLeads]"
                      lineageId="Package\DFT_LoadLeadsSummary\Extract de PromptCRM.Outputs[OLE DB Source Output].Columns[totalLeads]"
                      name="totalLeads"
